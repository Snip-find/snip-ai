{
  "manifest_version": 3,
  "name": "Snip \u2014 Find It In Context",
  "version": "2.3.71",
  "description": "Search webpages and PDFs, jump to relevant passages, and reuse a local PDF text index.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://extensionpay.com/*",
    "https://snip-chi.vercel.app/*",
    "https://zkkmgrsrchnwvijeyyan.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Snip"
  },
  "commands": {
    "find-important": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "MacCtrl+Shift+S"
      },
      "description": "Open Snip on the current page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://extensionpay.com/*"
      ],
      "js": [
        "ExtPay.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
